---
import UtilityLayout from '../../../../components/pc/UtilityLayout.astro';
import {loadCatalog,appSources} from '../../../../scripts/catalog/catalog.mjs';
const version=String(appSources(loadCatalog(),'sqliteviz','github-release')[0].tag).replace(/^v/,'');
---
<UtilityLayout title="SQLiteViz">
  <header><h1>SQLiteViz</h1><a href="/pc/vendor/sqliteviz/index.html" target="_blank" rel="noopener">Open full page ↗</a><a href="/third-party/sqliteviz/LICENSE" target="_blank" rel="noopener">Licence</a></header>
  <p class="utility-note">Version {version} · Self-hosted, runs entirely in your browser. Map charts fetch tiles from public map tile servers when you create a map.</p>
  <main class="utility-frame"><iframe id="sqliteviz-frame" title="SQLiteViz" src="/pc/vendor/sqliteviz/index.html"></iframe><div class="utility-loading" id="sqliteviz-loading" role="status"><span id="sqliteviz-status">Loading SQLiteViz…</span><button id="sqliteviz-retry" hidden>Retry</button></div></main>
  <script>import '../../../../scripts/pc/apps/sqliteviz.mjs';</script>
</UtilityLayout>
