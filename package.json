{
  "name": "webpc",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "catalog": "node scripts/catalog/catalog.mjs",
    "predev": "npm run catalog",
    "dev": "npm run assets:pc && astro dev",
    "prebuild": "npm run catalog",
    "build": "npm run assets:pc && astro build && node scripts/catalog/prune.mjs && node scripts/catalog/size-check.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "pretest": "npm run catalog",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:browser": "playwright test --config scripts/qa/playwright.config.mjs",
    "assets:pc": "node scripts/pc/prepare-docs.mjs && node scripts/pc/prepare-cyberchef.mjs && node scripts/pc/prepare-terminal.mjs && node scripts/pc/prepare-craft.mjs && node scripts/pc/prepare-ai-agent.mjs && node scripts/pc/prepare-static-apps.mjs && node scripts/pc/prepare-excalidraw.mjs && node scripts/pc/prepare-nettools.mjs && node scripts/pc/prepare-packets.mjs && node scripts/catalog/icons.mjs",
    "upgrade": "node scripts/upgrade/upgrade.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.2",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.11.0",
    "@casualoffice/docs": "1.4.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/material-symbols-outlined": "5.3.9",
    "@playwright/test": "^1.65.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-serialize": "0.13.0",
    "@xterm/xterm": "5.5.0",
    "@zxcvbn-ts/core": "4.3.0",
    "@zxcvbn-ts/language-common": "4.2.0",
    "@zxcvbn-ts/language-en": "4.1.2",
    "age-encryption": "0.3.1",
    "esbuild": "0.27.7",
    "jszip": "3.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semver": "7.8.6",
    "v86": "0.5.473",
    "yaml": "2.9.1"
  }
}
